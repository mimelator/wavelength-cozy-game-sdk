  "features": [
    {
      "name": "Mood-Based Music Generation",
      "description": "Six distinct emotional moods that transform touch into unique musical experiences"
    },
    {
      "name": "Interactive Audio Canvas",
      "description": "Click and drag to paint music across a visual canvas with real-time audio feedback"
    },
    {
      "name": "Multiple Instruments",
      "description": "Piano, chimes, strings, flute, ambient, and nature sounds for diverse musical expression"
    },
    {
      "name": "Visual Particle System",
      "description": "Beautiful animated particles that respond to musical notes and mood colors"
    },
    {
      "name": "Progressive Achievement System",
      "description": "17 unique badges rewarding creativity, exploration, and musical mastery"
    },
    {
      "name": "Therapeutic Experience",
      "description": "Designed for relaxation, stress relief, and emotional expression through music"
    }
  ],
