  "thumbnail": "thumbnail.svg",
  "screenshot": "screenshot.svg",
  "entry_point": "index.html",

  "controls": {
    "mouse": "Click and drag the ship to aim and shoot",
    "touch": "Touch and drag the ship to aim and shoot",
    "keyboard": "B key: Spawn black hole (debug), C key: Spawn comet storm (debug)"
  },

  "features": [
    "Custom WebGL vector graphics rendering",
    "Realistic physics simulation with elastic collisions",
    "Dynamic special mechanics (black holes, comets)",
    "Particle effects and visual feedback",
    "Cross-platform input (mouse and touch)",
    "Responsive fullscreen gameplay",
    "Achievement system with badges"
  ],

  "technical": {
    "canvas_based": true,
    "dom_based": false,
    "physics_engine": "Custom impulse-based 2D physics",
    "rendering": "WebGL with custom shaders",
    "responsive": true,
    "performance": "Optimized particle system with lifecycle management",
    "dependencies": [],
    "es_modules": true,
    "webgl_required": true
  },

  "theme": {
    "name": "space",
    "primaryColor": "#00ffff",
    "secondaryColor": "#ff00ff",
    "backgroundColor": "#050505",
    "textColor": "#ffffff",
    "accentColor": "#00ff00",
    "font": "'Courier New', Courier, monospace"
